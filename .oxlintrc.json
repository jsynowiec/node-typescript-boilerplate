{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "env": {
    "node": true
  },
  "ignorePatterns": ["**/build/**", "**/tmp/**", "**/coverage/**"],
  "rules": {
    "no-unused-vars": "error",
    "typescript/no-explicit-any": "error"
  },
  "overrides": [
    {
      "files": ["**/*.ts", "**/*.mts"],
      "rules": {
        "typescript/explicit-function-return-type": "warn"
      }
    },
    {
      "files": ["__tests__/**"],
      "plugins": ["vitest"],
      "env": {
        "vitest": true
      }
    }
  ]
}
